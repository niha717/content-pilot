# 默认不连接模型，使用透明规则分析。
AI_CHAT_PROVIDER=none
AI_EMBEDDING_PROVIDER=none
# 启用真实模型：将以上相应值改为 openai（指兼容协议），填入你的服务配置。
AI_API_KEY=
AI_BASE_URL=https://api.openai.com
AI_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
# 图片理解要求聊天模型支持视觉。音视频转写独立配置。
ASR_API_KEY=
ASR_API_URL=https://api.openai.com/v1/audio/transcriptions
ASR_MODEL=whisper-1
FFMPEG_PATH=ffmpeg
# 仅本机访问；默认 H2 文件库，记录与附件存放在 data/。
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
LOAD_REFERENCES=true
# 只加载真实来源快照，绝不生成演示历史。
